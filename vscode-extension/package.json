{
  "name": "mcp-medic-vscode",
  "displayName": "mcp-medic (experimental)",
  "description": "EXPERIMENTAL, unpublished: in-editor diagnostics and hover tooltips for MCP server config files, backed by mcp-medic's checks.",
  "version": "0.0.1",
  "private": true,
  "publisher": "mcp-medic-local-dev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Linters"],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "package": "npx --yes @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.5.0"
  }
}
